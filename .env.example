# ── Gmail (IMAP) ──────────────────────────────────────────────────────────────
# 앱 비밀번호 방식 (2단계 인증 + Google 계정 → 보안 → 앱 비밀번호)
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
B2B_LABEL=B2B_INQUIRY

# ── Slack (선택) ──────────────────────────────────────────────────────────────
# Incoming Webhook URL — 미설정 시 알림 호출은 no-op
# 구버전 SLACK_WEBHOOK_DEALS / SLACK_WEBHOOK_ERRORS도 폴백으로 인식됨
SLACK_WEBHOOK=https://hooks.slack.com/services/...

# ── 회사/디렉터 정보 (어드민 /settings에서도 편집 가능) ────────────────────────
# settings 테이블 값이 우선이고 여기는 폴백
DIRECTOR_NAME=이름
DIRECTOR_EMAIL=your@gmail.com
ANTIEGG_CEO=대표자명
ANTIEGG_BIZ_NO=000-00-00000
ANTIEGG_PHONE=02-0000-0000
ANTIEGG_EMAIL=your@gmail.com
ANTIEGG_ADDR=서울시 ...

# ── 네트워크 / ngrok ──────────────────────────────────────────────────────────
# 정적 도메인 (계정당 1개 무료 — dashboard.ngrok.com/domains 에서 발급)
# 설정 시 server.sh가 --url=$NGROK_DOMAIN 으로 호출해 매 재시작 동일 URL 보장
# 미설정 시 ngrok이 매번 random URL 발급
NGROK_DOMAIN=your-static.ngrok-free.dev

# 클라이언트가 접근할 수 있는 앱 공개 URL (서명 링크 이메일에 사용)
# server.sh가 ngrok 기동 후 자동 갱신
APP_BASE_URL=https://your-static.ngrok-free.dev

# ── 백업 (선택) ───────────────────────────────────────────────────────────────
# 미설정 시 디폴트: ~/Library/Mobile Documents/com~apple~CloudDocs/antiegg-b2b-backups (iCloud Drive)
# Dropbox/외장디스크/네트워크 마운트 등으로 변경 가능. 매일 03:30 자동 백업
# BACKUP_DIR=/path/to/backups
# BACKUP_RETENTION_DAYS=30
